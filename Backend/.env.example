# Porta em que o servidor irá rodar
PORT=5000

# URL de conexão com o banco de dados MongoDB (exemplo fictício)
MONGO_URI=mongodb+srv://seu-usuario:sua-senha@cluster.mongodb.net/nome-do-banco?retryWrites=true&w=majority

# Chave secreta para a criptografia dos tokens JWT
JWT_SECRET=sua_chave_secreta_super_segura_aqui